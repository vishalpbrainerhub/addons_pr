<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Customer-Agent Relationship Import -->
        <record id="ir_cron_customer_agent_import" model="ir.cron">
            <field name="name">Import Customer-Agent Relationships</field>
            <field name="model_id" ref="model_data_importer"/>
            <field name="state">code</field>
            <field name="code">model.import_customer_agent_relationships()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
            <field name="priority">25</field>
        </record>
    </data>
</odoo>