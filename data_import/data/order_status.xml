<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Order Status Import -->
        <record id="ir_cron_order_status_import" model="ir.cron">
            <field name="name">Import Order Status Data</field>
            <field name="model_id" ref="model_data_importer"/>
            <field name="state">code</field>
            <field name="code">model.import_order_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>