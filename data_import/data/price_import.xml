<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Customer Import -->
        <record id="ir_cron_price_import" model="ir.cron">
            <field name="name">Import Price Data</field>
            <field name="model_id" ref="model_data_importer"/>
            <field name="state">code</field>
            <field name="code">model.import_price_xmlrpc()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
            <field name="priority">20</field>
        </record>
    </data>
</odoo>